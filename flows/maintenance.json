{
  "version": "6.0",
  "routing_model": {
    "MAINTENANCE": []
  },
  "screens": [
    {
      "id": "MAINTENANCE",
      "title": "Maintenance",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Report an Issue"
          },
          {
            "type": "TextBody",
            "text": "Describe the problem. Technician will be assigned."
          },
          {
            "type": "Form",
            "name": "maint_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "issue_type",
                "label": "Issue type",
                "required": true,
                "data-source": [
                  {
                    "id": "ac",
                    "title": "AC not working"
                  },
                  {
                    "id": "tv",
                    "title": "TV / WiFi"
                  },
                  {
                    "id": "plumbing",
                    "title": "Plumbing"
                  },
                  {
                    "id": "electrical",
                    "title": "Electrical"
                  },
                  {
                    "id": "other",
                    "title": "Other"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "priority",
                "label": "Priority",
                "required": true,
                "data-source": [
                  {
                    "id": "high",
                    "title": "High"
                  },
                  {
                    "id": "medium",
                    "title": "Medium"
                  },
                  {
                    "id": "low",
                    "title": "Low"
                  }
                ]
              },
              {
                "type": "TextArea",
                "name": "details",
                "label": "More details",
                "required": true,
                "helper-text": "e.g. AC making noise, remote not working"
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "issue_type": "${form.issue_type}",
                    "priority": "${form.priority}",
                    "details": "${form.details}",
                    "flow_name": "maintenance"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
