{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": { "VALET": [] },
  "screens": [
    {
      "id": "VALET",
      "title": "Valet",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Valet Service" },
          { "type": "TextBody", "text": "Choose one option." },
          {
            "type": "Form",
            "name": "valet_form",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "valet_type",
                "label": "What do you need?",
                "required": true,
                "data-source": [
                  { "id": "luggage_down", "title": "Luggage Down" },
                  { "id": "car_retrieve", "title": "Car Retrieve" }
                ]
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "valet_type": "${form.valet_type}",
                    "flow_name": "valet"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
