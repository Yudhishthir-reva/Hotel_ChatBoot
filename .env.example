# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hotel_whatsapp_crm

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Admin JWT
JWT_SECRET=change_this_to_a_random_secret_key

# Hotel (default hotel id for single-hotel MVP)
DEFAULT_HOTEL_ID=1

# Static staff names shown on food order confirm (demo)
HOTEL_CHEF_NAME=Chef Ramesh
HOTEL_WAITER_NAME=Amit

PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev

# false = classic buttons/lists demo | true = WhatsApp Flows (after Meta approve)
USE_WHATSAPP_FLOWS=false

# WhatsApp Flows — publish each JSON in Meta, paste Flow IDs (docs/WHATSAPP_FLOWS.md)
WHATSAPP_LAUNDRY_FLOW_ID=
WHATSAPP_HOUSEKEEPING_FLOW_ID=
WHATSAPP_VALET_FLOW_ID=
WHATSAPP_TRANSPORT_FLOW_ID=
WHATSAPP_MAINTENANCE_FLOW_ID=
WHATSAPP_CHECKOUT_FLOW_ID=
WHATSAPP_FOOD_FLOW_ID=
WHATSAPP_FOOD_EDIT_FLOW_ID=
WHATSAPP_FACILITIES_FLOW_ID=
